    <string name="volc_lang_fr_fr">法语 (fr-FR)</string>
    <string name="volc_lang_ko_kr">韩语 (ko-KR)</string>
    <string name="volc_lang_fil_ph">菲律宾语 (fil-PH)</string>
    <string name="volc_lang_ms_my">马来语 (ms-MY)</string>
